# Challenger Deep / Abyss OS - Environment Configuration
# Copy this file to .env.local and fill in your values

# ═══════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Get these from Firebase Console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (for server-side operations)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ═══════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════
# JWT secret for session tokens (generate a random string)
JWT_SECRET=your_random_secret_key_here_minimum_32_characters

# Session configuration
SESSION_MAX_AGE=604800  # 7 days in seconds
SESSION_COOKIE_NAME=challenger_deep_session

# ═══════════════════════════════════════════════════════════
# DISCORD BOT (for cloud storage via Discord)
# ═══════════════════════════════════════════════════════════
# Create a bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ═══════════════════════════════════════════════════════════
# TELEGRAM BOT (alternative cloud storage)
# ═══════════════════════════════════════════════════════════
# Create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ═══════════════════════════════════════════════════════════
# AI SERVICES (optional - for AI chat features)
# ═══════════════════════════════════════════════════════════
# Google AI / Gemini
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (if using OpenAI instead)
OPENAI_API_KEY=your_openai_api_key_here

# ═══════════════════════════════════════════════════════════
# REDIS (optional - for caching and session storage)
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_if_any

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Base URL for your deployment
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel deployment (automatically set by Vercel)
# VERCEL_URL=your-app.vercel.app

# Cloudflare Pages deployment (automatically set by Cloudflare)
# CF_PAGES_URL=your-app.pages.dev

# ═══════════════════════════════════════════════════════════
# GOOGLE COMPUTE ENGINE (optional - for GPU compute)
# ═══════════════════════════════════════════════════════════
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ZONE=us-central1-a
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ═══════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════
# Enable/disable features
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_CLUSTER=true
NEXT_PUBLIC_ENABLE_GPU_RENTAL=false
NEXT_PUBLIC_ENABLE_VPS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ═══════════════════════════════════════════════════════════
# GAMES CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Game catalog settings
GAMES_CACHE_DURATION=3600000  # 1 hour in milliseconds
GAMES_PER_PAGE=24

# Game proxy settings
GAME_PROXY_TIMEOUT=15000  # 15 seconds
GAME_PROXY_MAX_SIZE=52428800  # 50MB

# ═══════════════════════════════════════════════════════════
# SECURITY SETTINGS
# ═══════════════════════════════════════════════════════════
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW=60000  # 1 minute in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# File upload limits
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
MAX_CHUNK_SIZE=5242880  # 5MB in bytes

# ═══════════════════════════════════════════════════════════
# DEVELOPMENT SETTINGS
# ═══════════════════════════════════════════════════════════
# Development mode
NODE_ENV=development

# Debug logging
DEBUG=false
VERBOSE_LOGGING=false

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# ═══════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Keep sensitive keys (like FIREBASE_ADMIN_PRIVATE_KEY) server-side only
# - Use .env.local for local development (automatically gitignored)
# - Use Vercel/Cloudflare dashboard for production environment variables
# - Generate strong random strings for JWT_SECRET (use: openssl rand -base64 32)
